+// home-server patch: text injection
+int moshi_lm_force_text( moshi_lm_gen_t * gen, tokenizer_t * tok, const char * text ) {
+    std::vector<int> ids;
+    tok->sp.Encode( text, &ids );
+    for ( auto id : ids ) gen->forced_text.push_back( id );
+    return (int) ids.size();
+}
+
+void moshi_lm_force_pause( moshi_lm_gen_t * gen, int frames ) {
+    for ( int i = 0; i < frames; i++ ) gen->forced_text.push_back( 3 );  // PAD
+}
+
+void moshi_lm_force_mode( moshi_lm_gen_t * gen, int mode, int nudge ) {
+    gen->lmgen.force_mode = mode;
+    gen->lmgen.force_nudge = nudge;
+}
+
+int moshi_lm_forced_pending( moshi_lm_gen_t * gen ) {
+    return (int) gen->forced_text.size();
+}
+
+void moshi_lm_force_clear( moshi_lm_gen_t * gen ) {
+    gen->forced_text.clear();
+}
+
 void moshi_lm_send( moshi_lm_gen_t * gen, Entry * entry ) {
     gen->machine_state->entries.push_back( *entry );
 }
