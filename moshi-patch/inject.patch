+    if ( lmgen->forced_text && ! lmgen->forced_text->empty() ) {
+        const int PAD = 3, EPAD = 0;
+        int front = lmgen->forced_text->front();
+        if ( front == PAD || front == EPAD ) {
+            // queued pauses / word-starts are always forced: a PAD run breaks the model's own
+            // plan (it goes quiet), so the words that follow are spoken as injected
+            text_token = front;
+            lmgen->forced_text->pop_front();
+            lmgen->force_idle = 0;
+        } else if ( lmgen->force_mode == 1 ) {
+            text_token = lmgen->forced_text->front();
+            lmgen->forced_text->pop_front();
+        } else if ( text_token != PAD && text_token != EPAD ) {
+            text_token = lmgen->forced_text->front();
+            lmgen->forced_text->pop_front();
+            lmgen->force_idle = 0;
+        } else if ( text_token == PAD && ++lmgen->force_idle > lmgen->force_nudge ) {
+            text_token = EPAD;          // nudge: "a word starts next"
+            lmgen->force_idle = 0;
+        }
+    } else if ( lmgen->forced_text ) {
